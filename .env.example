# Contact form delivery (https://dashboard.emailjs.com)
# Copy to .env.local and fill in. Until these are set, the contact form
# tells visitors to email directly instead of faking a successful send.
#
# Lock the key down by adding your deployed domain to EmailJS →
# Account → Security → Allowed origins.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
